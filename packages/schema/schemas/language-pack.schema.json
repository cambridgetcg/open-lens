{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-lens:schema:language-pack:0.1.0",
  "title": "Open Lens declarative language pack",
  "type": "object",
  "required": ["object", "schema_version", "id", "name", "version", "updated", "license", "languages", "techniques", "rules"],
  "additionalProperties": false,
  "properties": {
    "object": { "const": "language-pack" },
    "schema_version": { "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "key", "name", "family", "status", "what", "mechanism", "benign_reading", "output_phrasing"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "status": { "enum": ["live", "reference", "candidate"] },
          "what": { "type": "string", "minLength": 1 },
          "mechanism": { "type": "string", "minLength": 1 },
          "benign_reading": { "type": "string", "minLength": 1 },
          "output_phrasing": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "technique_id", "language", "kind", "source", "flags", "provenance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "technique_id": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["surface", "regex"] },
          "source": { "type": "string", "minLength": 1 },
          "flags": { "type": "string", "minLength": 1 },
          "provenance": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "required": ["kind"],
              "properties": { "kind": { "const": "surface" } }
            },
            "then": {
              "properties": {
                "source": { "pattern": "\\S" },
                "flags": { "const": "giu" }
              }
            }
          },
          {
            "if": {
              "required": ["kind"],
              "properties": { "kind": { "const": "regex" } }
            },
            "then": {
              "properties": {
                "flags": {
                  "allOf": [
                    { "pattern": "g" },
                    { "not": { "pattern": "y" } }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
